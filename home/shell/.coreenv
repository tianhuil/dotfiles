# ============================================================================
# coreenv — environment variables for all shells (zsh, bash, scripts)
# Source from .zshenv (zsh), .bash_profile (bash login), .bashrc (bash interactive)
# ============================================================================

# homebrew
if [ -f "/opt/homebrew/bin/brew" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Set variables for NPM.  Based on https://gist.github.com/DanHerbert/9520689
export NPM_PACKAGES="$HOME/.npm-packages"
export NODE_PATH="$NPM_PACKAGES/lib/node_modules:$NODE_PATH"
export PATH="$PATH:$NPM_PACKAGES/bin"  # npm packages should have lower priority
if [ -d /Volumes/Workspace/.bun/cache ]; then
  export BUN_INSTALL_CACHE_DIR=/Volumes/Workspace/.bun/cache
fi

# npm user config → gitignored ~/.npmrc.secrets so `npm login` never writes
# tokens into the stowed (tracked) ~/.npmrc
export NPM_CONFIG_USERCONFIG="$HOME/.npmrc.secrets"

# ~/.local/bin (lychee, uv, llm, …) — prepend so these win over
# brew copies and are visible to non-interactive shells (e.g. Orca)
if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# pi-node — glob so self-updates to a new node version don't break the path
_pi_node_base="$HOME/.local/share/pi-node"
if [ -d "$_pi_node_base" ]; then
  for _pi_node_bin in "$_pi_node_base"/node-*/bin; do
    if [ -d "$_pi_node_bin" ]; then
      export PATH="$_pi_node_bin:$PATH"
      break
    fi
  done
fi
unset _pi_node_bin _pi_node_base

# opencode when on Linux
if [ -d "$HOME/.opencode/bin" ]; then
  export PATH=$PATH:$HOME/.opencode/bin
fi

# Go SDK binary dir (Ubuntu/Ansible installs to /usr/local/go; macOS uses brew)
[ -d /usr/local/go/bin ] && export PATH="$PATH:/usr/local/go/bin"
# Go workspace
if [ -x "$(command -v go)" ]; then
  export GOPATH=$(go env GOPATH)
  export PATH=$PATH:$GOPATH/bin  # go packages should have lower priority
fi

# icu4c (for CGO support)
if command -v brew &>/dev/null && brew --prefix icu4c &>/dev/null; then
  export CGO_CPPFLAGS="-I$(brew --prefix icu4c)/include"
  export CGO_LDFLAGS="-L$(brew --prefix icu4c)/lib"
fi

# Java
if [ -d "/opt/homebrew/opt/openjdk/bin" ]; then
  export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"
fi

# libpq
if [ -d "/opt/homebrew/opt/libpq/bin" ]; then
  export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
fi

# sqlite
if [ -d "/opt/homebrew/opt/sqlite/bin" ]; then
  export PATH="/opt/homebrew/opt/sqlite/bin:$PATH"
fi

# bun
if [ -d "$HOME/.bun/bin" ]; then
  export PATH="$HOME/.bun/bin:$PATH"
fi

# uv — installed to ~/.local/bin by https://astral.sh/uv/install.sh
# (already on PATH via the ~/.local/bin block above)

# pnpm — PNPM_HOME differs by platform (~/Library/pnpm on macOS,
# ~/.local/share/pnpm on Linux). pnpm v11+ puts global bins in
# $PNPM_HOME/bin; older releases put them directly in $PNPM_HOME.
# Add whichever exists so pnpm is on PATH across versions — the bare-dir
# fallback is what fixes "pnpm not picking up" on older layouts.
if [ "$(uname)" = "Darwin" ]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi
if [ -d "$PNPM_HOME/bin" ]; then
  export PATH="$PNPM_HOME/bin:$PATH"
elif [ -d "$PNPM_HOME" ]; then
  export PATH="$PNPM_HOME:$PATH"
fi

# editor
if [ -x "$(command -v code)" ]; then
  export VISUAL=code
  export EDITOR=code
elif [ -x "$(command -v cursor)" ]; then
  export VISUAL=cursor
  export EDITOR=cursor
elif [ -x "$(command -v emacs)" ]; then
  export VISUAL=emacs
  export EDITOR=emacs
else
  export VISUAL=vi
  export EDITOR=vi
fi

# 1password
if [ -f "$HOME/.config/op/plugins.sh" ]; then
  source $HOME/.config/op/plugins.sh
fi
if [ "$(uname)" = "Darwin" ]; then
  SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
  export SSH_AUTH_SOCK
fi

# nvm — lazy-load to avoid ~400ms on every shell startup.
# node/npm/npx go on PATH immediately; the `nvm` command loads on first use.
export NVM_DIR="$HOME/.nvm"
if [ -d "$NVM_DIR/versions/node" ]; then
  # Put the most-recently-installed node on PATH (instant — just an ls).
  _nvm_latest="$(command ls -t "$NVM_DIR/versions/node/" 2>/dev/null | head -1)"
  if [ -n "$_nvm_latest" ] && [ -d "$NVM_DIR/versions/node/$_nvm_latest/bin" ]; then
    export PATH="$NVM_DIR/versions/node/$_nvm_latest/bin:$PATH"
  fi
  unset _nvm_latest
fi
# Lazy wrapper: sources the full nvm.sh only when `nvm` is actually called.
nvm() {
  unset -f nvm
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    \. "$NVM_DIR/nvm.sh"
  elif [ -s "/opt/homebrew/opt/nvm/nvm.sh" ]; then
    \. "/opt/homebrew/opt/nvm/nvm.sh"
  elif [ -s "/usr/local/opt/nvm/nvm.sh" ]; then
    \. "/usr/local/opt/nvm/nvm.sh"
  fi
  nvm "$@"
}

if [ -f ~/.env.local ]; then
  source ~/.env.local
fi

# Spark (from .bashrc)
if [ -d /opt/spark ]; then
  export SPARK_HOME=/opt/spark
  export PATH=$PATH:$SPARK_HOME/bin:$SPARK_HOME/sbin
fi

# Java Home (from .bashrc)
if [ -f /usr/libexec/java_home ]; then
  export JAVA_HOME=$(/usr/libexec/java_home)
fi

# GCloud (from .bashrc)
if [ -L "$(command -v gcloud)" ]; then
  FULL_PATH=$(readlink $(command -v gcloud))
else
  FULL_PATH=$(command -v gcloud)
fi
export GCLOUD_PATH="$(dirname "$FULL_PATH")/../"
export GAEPATH="$GCLOUD_PATH/platform/google_appengine/"

# tmux (from .bashrc)
export EVENT_NOKQUEUE=1

# bash history size (also respected by zsh)
export HISTSIZE=1000000
