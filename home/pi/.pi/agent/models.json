// Thinking level mappings for models with reasoning support.
//
// Pi's 7 thinking levels (off, minimal, low, medium, high, xhigh, max) are fixed.
// thinkingLevelMap remaps each pi level to the provider-specific string sent to the API,
// or null to hide/disable it. Omitted keys inherit the built-in default.
//
// Only levels that produce distinct behavior are exposed.
// Binary-thinking models get off + one "on" level; effort-string models get each
// distinct effort tier.
//
// Effort models:  deepseek-v4-flash-free (low/high/max)
// Binary models:  glm-4.7-flash (off/high)
// Effort models:  glm-5.3* (low/high/max), gpt-6-sol/luna (none/low/medium/high/xhigh/max)

{
  "providers": {
    "opencode": {
      "modelOverrides": {
        // DeepSeek V4 Flash: reasoning_effort accepts low, high, max (medium/xhigh → high)
        "deepseek-v4-flash-free": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          }
        }
      }
    },
    "openai": {
      "modelOverrides": {
        "gpt-6-sol": {
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          }
        },
        "gpt-6-luna": {
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          }
        }
      }
    },
    "zai": {
      "modelOverrides": {
        // GLM-5.3 family: reasoning_effort accepts low, high, max.
        "glm-5.3": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          }
        },
        "glm-5.3-flash": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          }
        },
        "glm-5.3-flashx": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          }
        },
        // GLM-4.7 Flash: toggle-only reasoning.
        "glm-4.7-flash": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": null
          }
        }
      }
    }
  }
}
