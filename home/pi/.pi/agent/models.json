// Thinking level mappings for models with reasoning support.
//
// Pi's 7 thinking levels (off, minimal, low, medium, high, xhigh, max) are fixed.
// thinkingLevelMap remaps each pi level to the provider-specific string sent to the API,
// or null to hide/disable it. Omitted keys inherit the built-in default.
//
// Only levels that produce distinct behavior are exposed.
// Binary-thinking models get off + one "on" level; effort-string models get each
// distinct effort tier.
//
// Effort models:  deepseek-v4-flash-free (low/high/max)
// Binary models:  north-mini-code-free, glm-5, glm-5.1, glm-5-turbo (off/high)
// Effort models:  glm-5.2 (high/max)

{
  "providers": {
    "opencode": {
      "modelOverrides": {
        // DeepSeek V4 Flash: reasoning_effort accepts low, high, max (medium/xhigh → high)
        "deepseek-v4-flash-free": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          }
        },
        // Cohere North Mini: binary reasoning; "none" disables, anything else enables
        "north-mini-code-free": {
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": null
          }
        }
      }
    },
    "zai": {
      "modelOverrides": {
        // GLM-5 family (binary): zai thinking format, supportsReasoningEffort: false
        "glm-5": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": null
          }
        },
        "glm-5.1": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": null
          }
        },
        "glm-5-turbo": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": null
          }
        },
        // GLM-5.2: reasoning_effort accepts high, max
        "glm-5.2": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          }
        }
      }
    }
  }
}
