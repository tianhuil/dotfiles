# Thinking level mappings for models with reasoning support.
#
# Pi's 7 thinking levels (off, minimal, low, medium, high, xhigh, max) are fixed.
# thinkingLevelMap remaps each pi level to the provider-specific string sent to the API,
# or null to hide/disable it. Omitted keys inherit the built-in default.
#
# Only levels that produce distinct behavior are exposed.
# Binary-thinking models get off + one "on" level; effort-string models get each
# distinct effort tier.

{
  "providers": {
    "opencode": {
      "modelOverrides": {
        "deepseek-v4-flash-free": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          }
        },
        "north-mini-code-free": {
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": null
          }
        }
      }
    },
    "zai": {
      "modelOverrides": {
        "glm-5": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": null
          }
        },
        "glm-5.1": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": null
          }
        },
        "glm-5-turbo": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": null
          }
        },
        "glm-5.2": {
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": null,
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          }
        }
      }
    }
  }
}
