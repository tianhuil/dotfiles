{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "packages": [
    "npm:pi-upgrade",
    "npm:@plannotator/pi-extension",
    "npm:@thunstack/auto-compact",
    "npm:pi-web-access",
    "git:github.com/tianhuil/pi-orca",
    "git:github.com/tianhuil/pi-dotenvx",
    "git:github.com/jonjonrankin/pi-caveman",
    "npm:pi-subagents@^0.78.0",
    "npm:@lanlance/pi-btw"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-6.2-sol",
    "zai/glm-5.4",
    "zai/glm-5.3-flash"
